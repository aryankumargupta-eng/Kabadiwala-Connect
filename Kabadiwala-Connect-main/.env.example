# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

# Runtime
NODE_ENV=development
PORT=3000

# Local SQLite database used by Drizzle and the server
DATABASE_URL=file:./data/kabadiwala.db

# Session / application owner configuration
OWNER_OPEN_ID=

# Built-in storage service configuration
# Required when using server/storage.ts for image or evidence uploads.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional integrations
# Leave blank unless the corresponding integration is enabled.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_SECRET_KEY=


# Twilio Verify SMS OTP (required for real mobile OTP login/signup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
